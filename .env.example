# Ключи для подключения внешней ИИ модели к NlpMetaphorAgent (опционально)
# Достаточно указать любой один ключ:

# Вариант 1: Google Gemini (рекомендуется)
GEMINI_API_KEY=

# Вариант 2: OpenAI (или локальный Ollama/vLLM)
OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=gpt-4o-mini
